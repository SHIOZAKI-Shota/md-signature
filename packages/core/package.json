{
  "name": "@mdsig/core",
  "version": "0.1.2",
  "description": "Embedded, append-only signatures for Markdown documents. Zero dependencies, Web-standard APIs only.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SHIOZAKI-Shota/md-signature.git",
    "directory": "packages/core"
  },
  "homepage": "https://mdsig.dev/",
  "keywords": [
    "markdown",
    "signature",
    "ed25519",
    "e-signature",
    "rfc3161"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./examples/*": "./examples/*"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "check:web-standard": "node scripts/check-web-standard.mjs",
    "examples": "node scripts/gen-examples.ts",
    "build:tsa-roots": "node scripts/gen-tsa-roots.ts",
    "build:messages": "node scripts/gen-messages.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run check:web-standard && npm run build",
    "prepack": "node scripts/copy-examples.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
